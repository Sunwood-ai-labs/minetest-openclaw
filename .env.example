# OpenClaw World Environment
# Copy to .env and fill in your values

# LLM Provider for OpenClaw agents
# Options: openai, ollama, zai, anthropic, etc.
OPENCLAW_MODEL=ollama/gemma3:4b
OPENCLAW_OLLAMA_BASE_URL=http://host.containers.internal:11434

# Or use OpenAI:
# OPENCLAW_MODEL=openai/gpt-4o
# OPENCLAW_API_KEY=sk-...

# Bridge config
BRIDGE_PORT=8080
